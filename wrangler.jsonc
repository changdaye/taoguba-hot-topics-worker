{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taoguba-hot-topics-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "account_id": "d66336592b3f62650da1e5fa60e4a28c",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["30 0 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RUNTIME_KV",
      "id": "e8a18a11605240cd8d677801d36a1e42",
      "preview_id": "e8a18a11605240cd8d677801d36a1e42"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "BRIEF_DB",
      "database_name": "taoguba-hot-topics",
      "database_id": "77b2df7c-9eb3-4472-b4c9-e0b4b5a9897d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DIGEST_INTERVAL_HOURS": "24",
    "HEARTBEAT_INTERVAL_HOURS": "24",
    "REQUEST_TIMEOUT_MS": "15000",
    "FETCH_WINDOW_HOURS": "24",
    "MAX_POSTS_PER_DIGEST": "12",
    "MAX_REPLIES_PER_POST": "8",
    "LLM_MODEL": "gpt-5.4",
    "TGB_HOME_URL": "https://www.tgb.cn/",
    "TGB_BBS_URL": "https://www.tgb.cn/bbs/",
    "FAILURE_ALERT_THRESHOLD": "1",
    "FAILURE_ALERT_COOLDOWN_MINUTES": "180"
  }
}
